<section class="home">
  <figure class="weather-machine" aria-labelledby="machine-title">
    <figcaption class="machine-copy">
      <p class="eyebrow"><%= brand.tagline %></p>
      <h1 id="machine-title">The Atmospheric Filing Engine</h1>
      <p>Now processing improbable skies through brass, steam, and the proper forms.</p>
    </figcaption>
    <div class="machine-illustration" aria-hidden="true">
      <img class="layer-sky" src="/img/layers/00-sky.png?v=5" alt="">
      <span class="sun-path"><img class="sky-sun" src="/img/layers/03-sun.png?v=5" alt=""></span>
      <div class="sky-clouds">
        <img class="sky-cloud far" src="/img/layers/05-cloud-03.png?v=5" alt="">
        <img class="sky-cloud far delay-b" src="/img/layers/05-cloud-05.png?v=5" alt="">
        <img class="sky-cloud mid" src="/img/layers/05-cloud-01.png?v=5" alt="">
        <img class="sky-cloud mid delay-b" src="/img/layers/05-cloud-04.png?v=5" alt="">
        <img class="sky-cloud near" src="/img/layers/05-cloud-02.png?v=5" alt="">
        <img class="sky-cloud near delay-b" src="/img/layers/05-cloud-03.png?v=5" alt="">
      </div>
      <img class="layer-landscape" src="/img/layers/01-landscape.png?v=5" alt="">
      <span class="balloon-path"><img class="sky-balloon" src="/img/layers/04-balloon.png?v=5" alt=""></span>
      <div class="machine-rig">
        <div class="chimney-vent">
          <img class="drift-cloud cloud-a" src="/img/layers/05-cloud-01.png?v=5" alt="">
          <img class="drift-cloud cloud-b" src="/img/layers/05-cloud-02.png?v=5" alt="">
          <img class="drift-cloud cloud-c" src="/img/layers/05-cloud-03.png?v=5" alt="">
          <img class="drift-cloud cloud-d" src="/img/layers/05-cloud-04.png?v=5" alt="">
          <img class="drift-cloud cloud-e" src="/img/layers/05-cloud-05.png?v=5" alt="">
        </div>
        <img class="layer-machine" src="/img/layers/02-machine.png?v=5" alt="">
        <span class="cog-hub cog-one"><img src="/img/layers/cog-overlay-a.png?v=5" alt=""></span>
        <span class="cog-hub cog-two"><img src="/img/layers/cog-overlay-b.png?v=5" alt=""></span>
        <span class="cog-hub cog-three"><img src="/img/layers/cog-overlay-c.png?v=5" alt=""></span>
        <span class="cog-hub cog-four"><img src="/img/layers/cog-overlay-a.png?v=5" alt=""></span>
        <span class="dial"><span class="dial-needle"></span></span>
        <span class="lever"><span class="lever-rod"></span><span class="lever-bob"></span></span>
      </div>
      <img class="layer-bar" src="/img/layers/06-base-bar.png?v=5" alt="">
    </div>
  </figure>

  <div class="ticker" aria-label="Latest weather filings">
    <div class="ticker-track">
      <% for (const card of board.ticker) { %>
        <span class="ticker-item">
          ★ <%= card.name %> · <%= card.place %><% if (card.condition) { %> · <%= card.condition %><% } %><% if (card.reason) { %> — <%= card.reason %><% } %>
        </span>
      <% } %>
      <span class="ticker-copy" aria-hidden="true">
        <% for (const card of board.ticker) { %>
          <span class="ticker-item">
            ★ <%= card.name %> · <%= card.place %><% if (card.condition) { %> · <%= card.condition %><% } %><% if (card.reason) { %> — <%= card.reason %><% } %>
          </span>
        <% } %>
      </span>
    </div>
  </div>

  <section class="public-board" aria-labelledby="board-title">
    <p class="eyebrow">Public notices, duly stamped</p>
    <h2 id="board-title">The weather request board</h2>
    <div class="notice-grid">
      <% for (const card of [...board.theatre, ...board.real]) { %>
        <article class="notice-card notice-<%= card.kind %><%= card.stamped ? ' notice-stamped' : '' %>">
          <p class="notice-kind"><%= card.kind === 'theatre' ? 'Current atmospheric chit' : 'Filed request' %></p>
          <h3><%= card.place %></h3>
          <% if (card.temperatureC !== null) { %>
            <p class="notice-weather"><strong><%= card.temperatureC %>°C</strong> · <%= card.condition %></p>
          <% } %>
          <p><%= card.reason %></p>
          <p class="notice-filer">Filed by <strong><%= card.name || 'an unnamed petitioner' %></strong></p>
        </article>
      <% } %>
    </div>
  </section>
</section>
