<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= brand.name %></title>
    <link rel="stylesheet" href="/css/ministry.css">
  </head>
  <body>
    <aside class="disclaimer" role="note"><%= brand.disclaimerFull %></aside>
    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true"></span>
        <%= brand.name %>
      </a>
      <nav aria-label="Main navigation">
        <a href="/"><%= brand.nav.home %></a>
        <div class="forms-menu">
          <button type="button" class="forms-toggle" aria-expanded="false" aria-haspopup="true" aria-controls="forms-panel">
            <%= brand.nav.file %>
          </button>
          <div class="forms-panel" id="forms-panel" hidden>
            <p class="forms-heading">Frequent forms</p>
            <% forms.frequent.forEach((form) => { %>
              <a class="forms-item" href="<%= form.href %>">
                <span class="forms-code"><%= form.code %></span>
                <span class="forms-name"><%= form.name %></span>
              </a>
            <% }) %>
            <p class="forms-heading">Other schedules</p>
            <% forms.other.forEach((form) => { %>
              <button
                type="button"
                class="forms-item forms-restricted"
                data-code="<%= form.code %>"
                data-name="<%= form.name %>"
                data-refusal="<%= form.refusal %>"
              >
                <span class="forms-code"><%= form.code %></span>
                <span class="forms-name"><%= form.name %></span>
              </button>
            <% }) %>
          </div>
        </div>
        <a href="/ledger"><%= brand.nav.ledger %></a>
      </nav>
    </header>
    <main>
      <%- include(page) %>
    </main>
    <footer><%= brand.footer %></footer>
    <dialog class="privilege-slip" id="privilege-slip" aria-labelledby="privilege-title">
      <p class="eyebrow" id="privilege-title">Insufficient privileges</p>
      <p class="privilege-form"></p>
      <p class="privilege-copy"></p>
      <form method="dialog">
        <button class="button" type="submit">Very well</button>
      </form>
    </dialog>
    <script src="/js/forms-menu.js" defer></script>
  </body>
</html>
