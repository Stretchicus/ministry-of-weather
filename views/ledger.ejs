<section class="ledger">
  <p class="eyebrow">Personal chits</p>
  <h1>My ledger</h1>

  <% if (withdrawn) { %>
    <p class="form-error" role="status"><%= copy.stampReturned %></p>
  <% } %>
  <% if (clerkNote) { %>
    <p class="clerk-note"><%= clerkNote %></p>
  <% } %>

  <% if (!orders.length) { %>
    <p class="lede">The clerks have no paper in your name. Give a name on Form 27B if you are new to this desk.</p>
    <p><a class="button" href="/request"><%= brand.cta %></a></p>
  <% } else { %>
    <ul class="ledger-list">
      <% orders.forEach((order) => { %>
        <li class="ledger-row status-<%= order.status %> verdict-<%= order.verdict %>">
          <h2><%= order.place_name %></h2>
          <p class="lede">Filed as <%= visitor.display_name || 'unnamed' %><% if (order.reason) { %> — <%= order.reason %><% } %></p>
          <dl class="ledger-facts">
            <dt>Date/time requested</dt>
            <dd><%= order.filedAtLabel %></dd>
            <dt>Date/time for</dt>
            <dd><%= order.slotLabel %></dd>
            <dt>Weather requested</dt>
            <dd><%= order.requestedWeather %></dd>
            <dt>Actual weather</dt>
            <dd>
              <% if (order.verdict === 'observatory') { %>
                <%= copy.observatory %>
              <% } else if (order.actualWeather && order.status === 'aimed') { %>
                <%= order.actualWeather %> (forecast)
              <% } else if (order.actualWeather) { %>
                <%= order.actualWeather %>
              <% } else { %>
                Not yet observed
              <% } %>
            </dd>
            <dt>Verdict</dt>
            <dd class="ledger-verdict">
              <% if (order.verdict === 'accepted') { %>Accepted
              <% } else if (order.verdict === 'denied') { %>Denied
              <% } else if (order.verdict === 'withdrawn') { %>Withdrawn
              <% } else if (order.verdict === 'observatory') { %>Pending
              <% } else { %>Pending
              <% } %>
            </dd>
            <% if (order.denialReason) { %>
              <dt>Reason</dt>
              <dd><%= order.denialReason %></dd>
            <% } %>
          </dl>

          <% if (order.canCancel) { %>
            <form method="post" action="/orders/<%= order.id %>/cancel" class="cancel-form" onsubmit="return confirm('The clerks will not be happy. Withdraw this filing?');">
              <input type="hidden" name="confirm" value="yes">
              <button class="button button-quiet" type="submit">Withdraw this filing</button>
            </form>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>
